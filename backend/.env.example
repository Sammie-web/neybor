APP_NAME=NEYBOR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neybor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# For realtime deployments, use Reverb and configure the application credentials:
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

NEYBOR_MATCH_OFFER_TTL_SECONDS=90
NEYBOR_MATCH_MAX_DISTANCE_KM=50
NEYBOR_MATCH_MAX_ATTEMPTS=3
NEYBOR_MATCH_SERVICE_COMPATIBILITY=category
NEYBOR_MATCH_OFFER_MODE=sequential
NEYBOR_MATCH_OFFER_BATCH_SIZE=3
NEYBOR_MATCH_DISTANCE_WEIGHT=0.35
NEYBOR_MATCH_RELEVANCE_WEIGHT=0.30
NEYBOR_MATCH_RATING_WEIGHT=0.20
NEYBOR_MATCH_AVAILABILITY_WEIGHT=0.15
NEYBOR_MATCH_AVAILABILITY_FRESHNESS_MINUTES=120
NEYBOR_IDENTITY_DISK=local

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5182/

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
